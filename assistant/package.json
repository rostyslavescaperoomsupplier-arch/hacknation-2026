{
  "name": "mewka-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chat + voice assistant with the Mewka seagull, answering through Claude",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:server\" \"vite\"",
    "server": "node --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test 'tests/*.test.ts'",
    "bands": "node --env-file-if-exists=.env --experimental-strip-types server/simulate-bands.ts",
    "sensor": "node --env-file-if-exists=.env --experimental-strip-types server/trigger-sensor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
